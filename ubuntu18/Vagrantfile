# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  #maquina virtual
  config.vm.box = "ubuntu/bionic64"
  
  #configuracion de red
  config.vm.network "forwarded_port", guest: 8000, host: 8000
  config.vm.network "private_network", ip: "192.168.55.10"
  config.vm.network "public_network", bridge: "en0: Wi-Fi (Airport)"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1600"
    vb.cpus = 2
  end
  #aprivisionamiento instalar docker e levantar contenedores 
  config.vm.provision "shell", inline: <<-SHELL
    # Instalar Docker
    curl -fsSL https://get.docker.com -o get-docker.sh
    sudo sh get-docker.sh
    sudo usermod -aG docker vagrant
    
    # Instalar Docker Compose V2
    sudo apt-get update
    sudo apt-get install -y docker-compose-plugin
    
    # Descargar y ejecutar WordPress
    cd /home/vagrant
    sudo -u vagrant curl -o docker-compose.yml https://raw.githubusercontent.com/MarioAran/MarioCode/master/docker/docker-compose.yml
    sudo -u vagrant docker compose up -d

    echo "========================================="
    echo "✅ Instalación completada!"
    echo "📱 Accede a WordPress en: http://localhost:8000"
    echo "   o en: http://192.168.55.10:8000"
    echo "========================================="
  SHELL
end
