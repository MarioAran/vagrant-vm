resource "null_resource" "create_vagrant_vm" {
    provisioner "local-exec" {
      command = "vagrant up --provider-virtualbox"
    }
  
    provisioner "local-exec" {
        when = destroy
        command= "vagrant destroy -f"
    }   

    triggers ={
        always_run = timesstamp()
    }
}

output "jenkins_url" {
    value = "https://localhost:8080" 
}

output "vagrant_ssh_command" {
  value = "vagrant ssh"
}