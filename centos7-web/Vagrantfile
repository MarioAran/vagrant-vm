# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  config.vm.box = "geerlingguy/centos7"

  config.vm.network "private_network", ip: "192.168.33.10"
  config.vm.network "public_network", bridge: "en0: Wi-Fi (AirPort)"
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "1024"
  end
   config.vm.provision "shell", inline: <<-SHELL
    # Cambiar a root (sudo -i no es necesario aquí)
    echo "=== Configurando repositorio ==="
    sudo wget -O /etc/yum.repos.d/CentOS-Base.repo https://mirrors.aliyun.com/repo/Centos-7.repo
    
    # Limpiar cache y actualizar
    sudo yum clean all
    sudo yum makecache
    
    echo "=== Instalando paquetes ==="
    sudo yum install -y httpd wget unzip
    
    # Crear directorio si no existe (corrección: car/www/html → var/www/html)
    echo "=== Configurando Apache ==="
    sudo mkdir -p /var/www/html
    
    echo "=== Descargando y descomprimiendo plantilla ==="
    cd /var/www/html
    sudo wget https://www.tooplate.com/zip-templates/2160_exhibit_studio.zip
    sudo unzip -o 2160_exhibit_studio.zip
    
    echo "=== Moviendo archivos ==="
    sudo cp -r /var/www/html/2160_exhibit_studio/* /var/www/html/
    sudo rm -rf /var/www/html/2160_exhibit_studio
    sudo rm -f /var/www/html/2160_exhibit_studio.zip
    
    echo "=== Iniciando Apache ==="
    sudo systemctl start httpd
    sudo systemctl enable httpd
    
    echo "=== Verificando estado ==="
    sudo systemctl status httpd --no-pager
    
    echo "=== Provisionamiento completado ==="
    echo "Accede a: http://192.168.33.10"

   SHELL
end
